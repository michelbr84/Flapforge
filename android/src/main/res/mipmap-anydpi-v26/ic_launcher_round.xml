<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (API 26+): the launcher masks the central 72 dp of the 108 dp
     layers. Both layers derive from the desktop procedural icon (render/ProceduralArt.drawIcon);
     regenerate them with android/tools/IconGen.java, never by editing the PNGs. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
